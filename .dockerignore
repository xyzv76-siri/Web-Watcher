# Version control
.git
.gitignore

# Python artifacts
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg
*.egg-info
dist
build
.eggs

# Virtual environments
.venv
venv
env

# Test artifacts
.pytest_cache
.coverage
htmlcov
.tox
.mypy_cache

# IDE / editor artifacts
.vscode
.idea
*.swp
*.swo

# Local databases (persistent state must be mounted, not baked)
*.db
*.sqlite
*.sqlite3

# Logs and reports
logs/*
data/*
reports/*
*.log

# CI / packaging artifacts
*.tar.gz
*.whl

# Audit and baseline artifacts (not needed in production image)
audit/*
*.baseline
*.audit

# Secrets and local configs
.env
.env.*
!.env.example
*.secret
secrets/

# Docker artifacts
Dockerfile
docker-compose.yml
.dockerignore

# Documentation and phase reports (not needed at runtime)
*.md
!README.md
docs/
AUDIT_*.md
PART*_COMPLETION_REPORT.md
PHASE*.md
POST_*.md
GLOBAL_*.md
